# Convex (application data: users, jobs, applications, notifications)
# From `npx convex dev` the first time you run it locally.
NEXT_PUBLIC_CONVEX_URL=

# Neo4j AuraDB (graph: skills, connections, career paths)
# Create a free instance at https://console.neo4j.io -> download the
# credentials file it gives you, values go here. Server-side only —
# never expose these with a NEXT_PUBLIC_ prefix.
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
