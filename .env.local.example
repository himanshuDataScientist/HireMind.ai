# Copy this file to .env.local and fill in your own values. Never commit real secrets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-instance.clerk.accounts.dev

# Set this in Convex Dashboard > Settings > Environment Variables.
# Comma-separated Clerk user IDs allowed to review employer registrations.
HIREMIND_REVIEWER_CLERK_IDS=
